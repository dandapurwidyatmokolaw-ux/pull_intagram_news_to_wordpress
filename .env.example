# ================================================================
# KONFIGURASI SISTEM OTOMASI INSTAGRAM KE BERITA FH UNDIP
# Lokasi File: D:\dev_intagram_fh\.env
# ================================================================

# [1] TARGET INSTAGRAM (DINAMIS DAPAT DIUBAH KAPAN SAJA)
INSTAGRAM_TARGET_URL=https://www.instagram.com/law.undip/
INSTAGRAM_TARGET_USERNAME=law.undip

# [2] REPOSITORY GITHUB & APLIKASI
GITHUB_REPOSITORY=dandapurwidyatmokolaw-ux/pull_intagram_news_to_wordpress
APP_ENV=production
APP_PORT=5000
APP_BASE_URL=http://localhost:5000
DATA_DIR=/mnt/d/dev_intagram_fh/data

# [3] NOTIFIKASI EMAIL & KURATOR
CURATOR_EMAIL=danda.purwidyatmoko.law@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=danda.purwidyatmoko.law@gmail.com
SMTP_PASSWORD=bpoe rdgq oxoq itba
SMTP_FROM_NAME="Redaksi Berita FH Undip Bot"

# [4] AI GENERATOR (9ROUTER / OPENAI / LOCAL LLM)
AI_PROVIDER=9router
AI_API_BASE=http://127.0.0.1:20128/v1
AI_API_KEY=sk-your-token-here
AI_MODEL=gpt-4o

# [5] WORDPRESS REST API (ILMUHUKUM.UNDIP.AC.ID)
WP_BASE_URL=https://ilmuhukum.undip.ac.id
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx
